# Copy to .env and fill in.

# LLM for script generation — set the one you use (or both)
OPENAI_API_KEY=sk-...          # ChatGPT
ANTHROPIC_API_KEY=sk-ant-...   # Claude

# Optional: ElevenLabs if you later switch to paid voice
# ELEVENLABS_API_KEY=

# Optional: YouTube upload (OAuth client) — only if you enable auto-upload
# YOUTUBE_CLIENT_SECRETS=client_secret.json
